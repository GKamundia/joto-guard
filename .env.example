# Copy to .env and fill in. Never commit .env.

# Telegram bot (bot/README.md). From @BotFather.
TELEGRAM_BOT_TOKEN=

# Where the bot reads the guidance from. Defaults to http://127.0.0.1:8000.
JOTO_API_BASE=

# Where the bot keeps its subscribers. Defaults to data/subscriptions.json.
JOTO_SUBSCRIPTIONS=

# Comma-separated origins the API answers to, once the page is deployed (DEPLOY.md).
# Without it only the local Vite server may call the API.
JOTO_ALLOWED_ORIGINS=

# CHORDS portal, only for scripts/fetch_conduit_history.py. Downloading needs the
# "Data Downloader" permission, which a portal administrator grants.
CHORDS_EMAIL=
CHORDS_API_KEY=
